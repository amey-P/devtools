{
  "description": "Herdr peruse: questions on AskUserQuestion's permission request, and the last reply on Stop (inside herdr-app terminals only).",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/claude-ask.mjs\"",
            "timeout": 345600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/claude-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
